generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ENUM TABLE
model EnumTable {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId

  enumType  String
  enumValue String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([enumType, enumValue])

  // Relations
  userRoles       User[] @relation("UserRole")
  userBranches    User[] @relation("UserBranch")
  userSemesters   User[] @relation("UserSemester")
  userYears       User[] @relation("UserYear")
  userStatuses    User[] @relation("UserStatus")

  subjectBranches  Subject[] @relation("SubjectBranch")
  subjectSemesters Subject[] @relation("SubjectSemester")

  assignmentBranches  Assignment[] @relation("AssignmentBranch")
  assignmentSemesters Assignment[] @relation("AssignmentSemester")

  assignmentStatuses AssignmentStatus[] @relation("AssignmentStatusEnum")

  notificationTypes      Notification[] @relation("NotificationType")
  notificationReadStatus Notification[] @relation("NotificationReadStatus")
}

// USER
model User {
  id                     String   @id @default(auto()) @map("_id") @db.ObjectId
  name                   String   @default("")
  email                  String   @unique
  contactNumber          String
  password               String?

  passwordSetupToken     String?
  passwordSetupExpiresAt DateTime?

  code                   String   @unique

  roleId                 String   @db.ObjectId
  branchId               String   @db.ObjectId
  semesterId             String?  @db.ObjectId
  yearId                 String?  @db.ObjectId
  statusId               String   @db.ObjectId

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  deletedAt              DateTime?

  // Enum relations
  role     EnumTable  @relation("UserRole", fields: [roleId], references: [id])
  branch   EnumTable  @relation("UserBranch", fields: [branchId], references: [id])
  semester EnumTable? @relation("UserSemester", fields: [semesterId], references: [id])
  year     EnumTable? @relation("UserYear", fields: [yearId], references: [id])
  status   EnumTable  @relation("UserStatus", fields: [statusId], references: [id])

  // Relations
  professorSubjects  ProfessorSubject[]
  createdAssignments Assignment[] @relation("CreatedAssignments")
  assignmentStatuses AssignmentStatus[]
  otps               UserOtp[]
  notifications      Notification[]
}

// SUBJECT
model Subject {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  branchId   String   @db.ObjectId
  semesterId String   @db.ObjectId

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  branch   EnumTable @relation("SubjectBranch", fields: [branchId], references: [id])
  semester EnumTable @relation("SubjectSemester", fields: [semesterId], references: [id])

  professors  ProfessorSubject[]
  assignments Assignment[]

  @@unique([name, branchId, semesterId])
}

// PROFESSOR SUBJECT
model ProfessorSubject {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  professorId String   @db.ObjectId
  subjectId   String   @db.ObjectId

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  professor   User    @relation(fields: [professorId], references: [id])
  subject     Subject @relation(fields: [subjectId], references: [id])

  @@unique([professorId, subjectId])
}

// ASSIGNMENT
model Assignment {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String
  dueDate      DateTime
  attachment   String

  subjectId    String   @db.ObjectId
  branchId     String   @db.ObjectId
  semesterId   String   @db.ObjectId
  createdById  String   @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  branch    EnumTable @relation("AssignmentBranch", fields: [branchId], references: [id])
  semester  EnumTable @relation("AssignmentSemester", fields: [semesterId], references: [id])

  subject   Subject @relation(fields: [subjectId], references: [id])
  createdBy User    @relation("CreatedAssignments", fields: [createdById], references: [id])

  statuses AssignmentStatus[]
}

// ASSIGNMENT STATUS
model AssignmentStatus {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId    String   @db.ObjectId
  assignmentId String   @db.ObjectId
  statusId     String   @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  student    User       @relation(fields: [studentId], references: [id])
  assignment Assignment @relation(fields: [assignmentId], references: [id])
  status     EnumTable  @relation("AssignmentStatusEnum", fields: [statusId], references: [id])

  @@unique([studentId, assignmentId])
}

// USER OTP
model UserOtp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)

  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// NOTIFICATION
model Notification {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId

  userId       String   @db.ObjectId
  title        String
  message      String

  typeId       String   @db.ObjectId
  readStatusId String   @db.ObjectId

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  user       User      @relation(fields: [userId], references: [id])
  type       EnumTable @relation("NotificationType", fields: [typeId], references: [id])
  readStatus EnumTable @relation("NotificationReadStatus", fields: [readStatusId], references: [id])
}