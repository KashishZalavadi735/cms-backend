{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "resolveJsonModule": true,
    "types": ["node"],

    "typeRoots": ["./node_modules/@types", "./src/types"],

    "noImplicitAny": false
  },
  "include": ["src", "prisma"],
  "exclude": ["node_modules"]
}